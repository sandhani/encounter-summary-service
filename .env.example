# Shell examples only. The service does not automatically load .env files.
USE_LLM=0
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-terra
LLM_REASONING_EFFORT=low
# Used when USE_LLM=0; SUMMARY_URL takes precedence over SUMMARY_MOCK.
SUMMARY_MOCK=1
# SUMMARY_URL=http://127.0.0.1:9000/summary

# LLM summary word cap (includes headings; whitespace-separated words).
SUMMARY_MAX_WORDS=100
